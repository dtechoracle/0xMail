# Database - Use PostgreSQL for production
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="https://www.0xmail.co"
NEXTAUTH_SECRET="generate-a-secure-random-secret-here-minimum-32-characters"

# JWT Secret
JWT_SECRET="generate-a-secure-random-secret-here-minimum-32-characters"

# Google OAuth (NextAuth)
